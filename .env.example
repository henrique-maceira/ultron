# === Credenciais obrigatórias ===

# Chave da API da Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=coloque-sua-chave-aqui

# Token do bot do Telegram, obtido com o @BotFather
TELEGRAM_BOT_TOKEN=coloque-o-token-do-botfather-aqui

# Seu ID numérico de usuário no Telegram (ex.: use o @userinfobot para descobrir).
# O assistente só responde a este usuário — é pessoal e guarda dados privados.
OWNER_TELEGRAM_ID=123456789

# === Configurações opcionais (têm valores padrão) ===

# Provedor de IA (por ora apenas "anthropic")
LLM_PROVIDER=anthropic

# Modelo do cérebro
LLM_MODEL=claude-sonnet-5

# Fuso horário (formato IANA)
TIMEZONE=America/Sao_Paulo

# Horário do resumo diário de prioridades (HH:MM, 24h)
BRIEFING_TIME=08:00

# Caminho do banco SQLite. Use data/ultron.db para que scripts rodados no host e o
# container Docker (que monta ./data) usem SEMPRE o mesmo arquivo. No compose o valor
# é sobrescrito para /app/data/ultron.db (mesmo arquivo, visto de dentro do container).
DB_PATH=data/ultron.db

# === Google Agenda (opcional) ===
# Habilita as ferramentas de agenda. Deixe "false" até rodar o bootstrap OAuth.
GOOGLE_CALENDAR_ENABLED=false
# JSON do cliente OAuth (Desktop app), baixado do Google Cloud Console.
GOOGLE_CREDENTIALS_PATH=data/google_credentials.json
# Token gerado por `python scripts/gcal_auth.py` (contém o refresh token).
GOOGLE_TOKEN_PATH=data/google_token.json
# Qual agenda usar ("primary" = agenda principal da conta).
GOOGLE_CALENDAR_ID=primary
